; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Super Orbital"
config/name_localized={
"bn_BD": "সুপার অরবিতাল"
}
config/description="A precision platformer about a person born without natural gravity"
config/version="1.0"
run/main_scene="uid://c0l8r4h3amty4"
run/enable_alt_space_menu=true
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.019607844, 0, 0.019607844, 1)
boot_splash/use_filter=false
boot_splash/image="uid://c1irp1epn8nxl"
config/icon="uid://c1irp1epn8nxl"

[audio]

driver/output_latency=5

[autoload]

GameManager="*uid://clcu7dy3b7klm"
PhysicsManager="*uid://di6kutv2ooq8"
SaveManager="*uid://c2vk1jiu0i4wm"
DialogueManager="*uid://bcr5wlveiybf8"
SettingsManager="*uid://dm7k0kdagqtr8"
AudioManager="*uid://fgkjnnl23op1"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg", "res://addons/parallax2d_preview/plugin.cfg")

