[sub_resource type="Resource" id="Resource_i8xm3"]
script = ExtResource("1_0xj1j")
speaker = ExtResource("2_36mb8")
text = "Whoever made this facility somehow managed to make compact black holes to use as defense measures..."
metadata/_custom_type_script = "uid://b2364himxu4dy"

[sub_resource type="Resource" id="Resource_qossp"]
script = ExtResource("1_0xj1j")
speaker = ExtResource("2_36mb8")
text = "However... we should be able to use your dash jets to work around this..."
