metadata/_custom_type_script = "uid://b2364himxu4dy"

[sub_resource type="Resource" id="Resource_5s4a7"]
script = ExtResource("1_0xj1j")
speaker = ExtResource("2_36mb8")
text = "When you are in the radius of the black hole, press {jump} to float closer to it, and {down} to move away from it."
metadata/_custom_type_script = "uid://b2364himxu4dy"

[sub_resource type="Resource" id="Resource_v6n74"]
script = ExtResource("1_0xj1j")
speaker = ExtResource("2_36mb8")
text = "You can use its orbit to your advantage. Propel yourself forward using a slingshot mechanism."
metadata/_custom_type_script = "uid://b2364himxu4dy"

